# Only needed for local development. In the deployed site the API URL comes
# from /config.json, which CDK generates at deploy time.
# Leave unset to run the dashboard on built-in mock data.
VITE_API_URL=https://YOUR_API_ID.execute-api.eu-central-1.amazonaws.com/prod
# Polling interval in milliseconds
VITE_POLL_INTERVAL=2000
